# Managed by Shaffy OS (the power role); thresholds come from the supplement.
# Direct hibernation avoids relying on a later wake-up from suspend.
[UPower]
UsePercentageForPolicy=true
PercentageLow={{ __power_hibernate['low_percent'] }}
PercentageCritical={{ __power_hibernate['critical_percent'] }}
PercentageAction={{ __power_hibernate['action_percent'] }}
CriticalPowerAction=Hibernate
