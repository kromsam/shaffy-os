{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shaffy OS supplement",
  "description": "Personal settings that override the public defaults. Fields are added only together with the integration that consumes them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "supplement_id"
  ],
  "properties": {
    "schema_version": {
      "description": "Version of this settings format. Shaffy OS refuses versions it does not know.",
      "type": "integer"
    },
    "supplement_id": {
      "description": "Stable name of these settings across relocation; not a credential.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "ai": {
      "description": "AI tool integration.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "mcp_servers": {
          "description": "MCP servers merged into the Claude and Codex configurations; a name overrides or extends the default of the same name. Set enabled to false to remove that server from both configurations.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/mcp_server"
          }
        },
        "gbrain": {
          "description": "The GBrain knowledge base behind the gbrain integration.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "description": "The brain source the read-only MCP client may search."
            }
          }
        }
      }
    },
    "desktop": {
      "description": "Desktop choices for Niri and Noctalia.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "displays": {
          "description": "Niri output blocks; absent means Niri configures outputs itself.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/display"
          }
        },
        "keyboard": {
          "description": "xkb settings; absent means Niri follows localectl.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "required": [
            "layouts"
          ],
          "properties": {
            "layouts": {
              "type": "string",
              "pattern": "^[a-z0-9_]+(,[a-z0-9_]+)*$"
            },
            "variants": {
              "type": "string",
              "pattern": "^[a-z0-9_]*(,[a-z0-9_]*)*$"
            },
            "options": {
              "type": "string",
              "pattern": "^[a-z0-9_:+-]+(,[a-z0-9_:+-]+)*$"
            }
          }
        },
        "wallpaper": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "directory": {
              "$ref": "#/$defs/path"
            },
            "image": {
              "$ref": "#/$defs/path"
            }
          }
        },
        "lock_screen": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "image": {
              "$ref": "#/$defs/path"
            }
          }
        },
        "browser": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.desktop$",
          "description": "Desktop entry of the default web browser, for http, https and HTML (for example zen.desktop)."
        }
      }
    },
    "folders": {
      "description": "Optional directory overrides relative to the home. Omitted standard roles follow the installation's XDG settings in any language. projects is a nonstandard target for compatibility links only.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "desktop": {
          "type": "string",
          "pattern": "^[^/\\u0000\\n\"\\\\$`]+$"
        },
        "documents": {
          "type": "string",
          "pattern": "^[^/\\u0000\\n\"\\\\$`]+$"
        },
        "downloads": {
          "type": "string",
          "pattern": "^[^/\\u0000\\n\"\\\\$`]+$"
        },
        "music": {
          "type": "string",
          "pattern": "^[^/\\u0000\\n\"\\\\$`]+$"
        },
        "pictures": {
          "type": "string",
          "pattern": "^[^/\\u0000\\n\"\\\\$`]+$"
        },
        "projects": {
          "type": "string",
          "pattern": "^[^/\\u0000\\n\"\\\\$`]+$"
        },
        "public": {
          "type": "string",
          "pattern": "^[^/\\u0000\\n\"\\\\$`]+$"
        },
        "templates": {
          "type": "string",
          "pattern": "^[^/\\u0000\\n\"\\\\$`]+$"
        },
        "videos": {
          "type": "string",
          "pattern": "^[^/\\u0000\\n\"\\\\$`]+$"
        }
      }
    },
    "overrides": {
      "description": "Native fragments from the supplement, applied after the public configuration. They are trusted configuration and may run commands.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "niri": {
          "$ref": "#/$defs/reference",
          "description": "Included last by ~/.config/niri/config.kdl."
        },
        "noctalia": {
          "$ref": "#/$defs/reference",
          "description": "Rendered as ~/.config/noctalia/97-supplement.toml."
        },
        "fish": {
          "$ref": "#/$defs/reference",
          "description": "Sourced at the end of ~/.config/fish/config.fish."
        },
        "alacritty": {
          "$ref": "#/$defs/reference",
          "description": "Imported last by ~/.config/alacritty/alacritty.toml."
        },
        "mise": {
          "$ref": "#/$defs/reference",
          "description": "Rendered as ~/.config/mise/conf.d/90-supplement.toml, which mise loads beside config.toml: personal runtimes and their settings."
        },
        "keyboard_hwdb": {
          "$ref": "#/$defs/reference",
          "description": "System scope: installed as /etc/udev/hwdb.d/90-shaffy-keyboard.hwdb, for keyboard key maps (for example Caps Lock as Super on one keyboard)."
        }
      }
    },
    "assets": {
      "description": "Personal files copied into the home, such as fonts, pictures and launchers: each key is a target under ~/, each value a file inside the supplement, or {file, executable, private}.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^~/(?!/)(?!(?:.*/)?\\.\\.?(?:/|$))(?!.*//)[^\\u0000-\\u001f\\u007f\"\\\\]+$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/reference"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file"
            ],
            "properties": {
              "file": {
                "$ref": "#/$defs/reference"
              },
              "executable": {
                "type": "boolean",
                "description": "Install with mode 0755."
              },
              "private": {
                "type": "boolean",
                "description": "Install readable by the user only."
              }
            }
          }
        ]
      }
    },
    "identity": {
      "description": "Git identity; absent leaves the user section out.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\n\"\\\\#;]+$"
        },
        "email": {
          "type": "string",
          "pattern": "^[^\\s@\"\\\\#;]+@[^\\s@\"\\\\#;]+$"
        },
        "signing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "description": "Public SSH key used to sign commits; signing is enabled only while this file exists.",
              "type": "string",
              "pattern": "^(~/|/)[^\\n\"\\\\#;]+$"
            }
          }
        }
      }
    },
    "tailnet": {
      "description": "The Tailnet this installation joins (Headscale or Tailscale).",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "login_server": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]+)?/?$",
          "description": "The coordination server, for the Noctalia Tailnet panel's admin link and for signing in."
        },
        "address": {
          "type": "string",
          "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}|[0-9A-Fa-f:]+)$",
          "description": "This node's Tailnet address; the system apply checks that the running client holds it."
        }
      }
    },
    "bitwarden": {
      "description": "The Bitwarden account's server.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "server_url": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$",
          "description": "Set by bitwarden-login before signing in; bw's own default otherwise."
        }
      }
    },
    "writing": {
      "description": "Defaults of the writing export profiles.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
          "description": "BCP 47 language of exported documents, for hyphenation and quotes (for example en-GB)."
        },
        "docx_reference": {
          "$ref": "#/$defs/path",
          "description": "A reference .docx whose styles DOCX exports take."
        }
      }
    },
    "kde_connect": {
      "description": "Where KDE Connect may reach this machine; without it no firewall rule is added.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface",
        "subnet"
      ],
      "properties": {
        "interface": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,15}$",
          "description": "Network interface, for example wlan0."
        },
        "subnet": {
          "type": "string",
          "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}|[0-9A-Fa-f:]+)/[0-9]{1,3}$",
          "description": "Allowed source network, for example 192.0.2.0/24."
        }
      }
    },
    "login": {
      "description": "How the desktop session starts.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "autologin": {
          "type": "boolean",
          "description": "Start Niri after disk unlock without a second password and unlock the keyring with the disk password. Refused unless / is on an encrypted device."
        }
      }
    },
    "folder_links": {
      "description": "English-named links in the home that point to the configured folders, for paths kept from an earlier layout. Unlisted names are left alone.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "Desktop": {
          "enum": [
            "desktop",
            "documents",
            "downloads",
            "music",
            "pictures",
            "projects",
            "public",
            "templates",
            "videos"
          ]
        },
        "Documents": {
          "enum": [
            "desktop",
            "documents",
            "downloads",
            "music",
            "pictures",
            "projects",
            "public",
            "templates",
            "videos"
          ]
        },
        "Downloads": {
          "enum": [
            "desktop",
            "documents",
            "downloads",
            "music",
            "pictures",
            "projects",
            "public",
            "templates",
            "videos"
          ]
        },
        "Music": {
          "enum": [
            "desktop",
            "documents",
            "downloads",
            "music",
            "pictures",
            "projects",
            "public",
            "templates",
            "videos"
          ]
        },
        "Pictures": {
          "enum": [
            "desktop",
            "documents",
            "downloads",
            "music",
            "pictures",
            "projects",
            "public",
            "templates",
            "videos"
          ]
        },
        "Projects": {
          "enum": [
            "desktop",
            "documents",
            "downloads",
            "music",
            "pictures",
            "projects",
            "public",
            "templates",
            "videos"
          ]
        },
        "Public": {
          "enum": [
            "desktop",
            "documents",
            "downloads",
            "music",
            "pictures",
            "projects",
            "public",
            "templates",
            "videos"
          ]
        },
        "Templates": {
          "enum": [
            "desktop",
            "documents",
            "downloads",
            "music",
            "pictures",
            "projects",
            "public",
            "templates",
            "videos"
          ]
        },
        "Videos": {
          "enum": [
            "desktop",
            "documents",
            "downloads",
            "music",
            "pictures",
            "projects",
            "public",
            "templates",
            "videos"
          ]
        },
        "Work": {
          "enum": [
            "desktop",
            "documents",
            "downloads",
            "music",
            "pictures",
            "projects",
            "public",
            "templates",
            "videos"
          ]
        }
      }
    },
    "packages": {
      "description": "Package choices on top of the public groups in defaults/packages/ (docs/SUPPLEMENT.md).",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "extra": {
          "$ref": "#/$defs/package_list",
          "description": "Also install these."
        },
        "omit": {
          "$ref": "#/$defs/package_list",
          "description": "Leave these group packages out; never uninstalls, never a required one."
        },
        "remove": {
          "$ref": "#/$defs/package_list",
          "description": "Remove these; only listed packages are removed."
        }
      }
    },
    "backup": {
      "description": "The home backup to a restic repository over SFTP (the backup integration activates its timers).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "tags",
        "repository"
      ],
      "properties": {
        "host": {
          "description": "Snapshot hostname; with the home path and tags it selects this installation's snapshots, so keep it when reinstalling.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "tags": {
          "description": "Tags every new snapshot carries; retention only ever touches snapshots with all of them.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          }
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sftp"
          ],
          "properties": {
            "id": {
              "description": "The repository's ID from restic-home inspect or init; backups refuse until it is set, and refuse a repository with another ID.",
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "sftp": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "host",
                "user",
                "path",
                "host_key"
              ],
              "properties": {
                "host": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]*$"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "user": {
                  "type": "string",
                  "pattern": "^[a-z_][a-z0-9_-]*$"
                },
                "path": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._/-]+$"
                },
                "host_key": {
                  "description": "The server's pinned public host key; no other key is accepted.",
                  "type": "string",
                  "pattern": "^ssh-ed25519 [A-Za-z0-9+/]+={0,2}$"
                }
              }
            }
          }
        },
        "excludes": {
          "description": "Home paths to leave out, in addition to the public caches and runtime paths.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^~/[^\\n]+$"
          }
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "daily": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "weekly": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "monthly": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        }
      }
    },
    "integrations": {
      "description": "Lifecycle states of optional integrations from defaults/integrations.yml (docs/SUPPLEMENT.md).",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "enum": [
          "managed",
          "disabled",
          "released"
        ]
      }
    }
  },
  "$defs": {
    "mcp_server": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "enabled": {
          "description": "Defaults to true. False removes this named MCP entry on home apply; omitting a server from settings leaves any existing entry alone.",
          "type": "boolean"
        },
        "command": {
          "description": "Program to start; a leading ~/ means the target home directory.",
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "description": "Connector name such as eDP-1.",
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        },
        "mode": {
          "type": "string",
          "pattern": "^[0-9]+x[0-9]+(@[0-9]+(\\.[0-9]+)?)?$"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            }
          }
        }
      }
    },
    "path": {
      "type": "string",
      "pattern": "^(~/|/)[^\\u0000\\n]*$",
      "description": "An absolute path, or one starting with ~/ for the target home."
    },
    "reference": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\u0000\\n]+$",
      "description": "A file inside the supplement, relative to its root."
    },
    "package_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9@_+][a-z0-9@._+-]*$"
      }
    }
  }
}
