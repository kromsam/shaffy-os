{{- $s := (includeTemplate "shaffy.json" . | fromJson).shaffy.settings -}}
{{- $folders := includeTemplate "folders.json" . | fromJson -}}
{{- $target := get $folders (get (dig "folder_links" dict $s) "Templates") -}}
{{- if hasPrefix (printf "%s/" .chezmoi.homeDir) $target -}}
{{- trimPrefix (printf "%s/" .chezmoi.homeDir) $target -}}
{{- else -}}{{ $target }}{{- end -}}
