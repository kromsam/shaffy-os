#!/bin/sh
# Run the merge script of the checkout that is applying, never a fixed path.
# Not private_: Codex and the tools that add their own hooks write the file as 0644.
: "${CHEZMOI_SOURCE_DIR:?run through chezmoi}"
exec /usr/bin/python3 "$CHEZMOI_SOURCE_DIR/../scripts/merge-ai-config.py" codex-hooks
