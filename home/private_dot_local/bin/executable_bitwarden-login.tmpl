#!/usr/bin/env bash
# Interactive credentials stay in this private terminal, never command arguments.
set -euo pipefail
printf 'Sign in to your Bitwarden account. Enter credentials only here.\n\n'
{{- with dig "bitwarden" "server_url" "" (includeTemplate "shaffy.json" . | fromJson).shaffy.settings }}
"$HOME/.local/bin/bw" config server {{ . | squote }} >/dev/null
{{- end }}
if "$HOME/.local/bin/bw" login; then
  "$HOME/.local/bin/bw" lock >/dev/null
  clear
  printf 'Bitwarden is signed in and locked.\nUnlock it with bw unlock when you need a credential.\n'
else
  printf '\nSign-in did not finish; Bitwarden stays signed out.\n'
fi
read -r -p 'Press Enter to close this window. ' answer
