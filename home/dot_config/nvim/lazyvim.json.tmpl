{{- /* LazyVim's extras: the public ones, then the supplement's `lazyvim.extras`. LazyVim
     loads them in its own order, whatever the order here. */ -}}
{{- $extras := list
  "lazyvim.plugins.extras.editor.neo-tree"
  "lazyvim.plugins.extras.lang.docker"
  "lazyvim.plugins.extras.lang.json"
  "lazyvim.plugins.extras.lang.markdown"
  "lazyvim.plugins.extras.lang.toml"
  "lazyvim.plugins.extras.lang.yaml"
  "lazyvim.plugins.extras.lang.tailwind"
-}}
{{- range dig "lazyvim" "extras" list (includeTemplate "shaffy.json" . | fromJson).shaffy.settings }}
{{-   if not (has . $extras) }}{{ $extras = append $extras . }}{{ end }}
{{- end -}}
{{- dict "extras" $extras "install_version" 8 "news" (dict "NEWS.md" "10960") "version" 8 | toPrettyJson -}}
