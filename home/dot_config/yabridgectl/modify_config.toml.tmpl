#!/usr/bin/python3
"""Own the bridge's paths; the other keys and the generated version cache stay yabridgectl's."""
import re
import sys

text = sys.stdin.read()
values = {
    'plugin_dirs': "['" + {{ printf "%s/.wine/drive_c/Program Files/VSTPlugins" .chezmoi.homeDir | toJson }} + "']",
    'yabridge_home': "'" + {{ printf "%s/.local/share/yabridge" .chezmoi.homeDir | toJson }} + "'",
}
for key, value in values.items():
    text, count = re.subn(r'^' + key + r'\s*=.*$', key + ' = ' + value, text, flags=re.M)
    if not count:
        text = key + ' = ' + value + '\n' + text
sys.stdout.write(text)
