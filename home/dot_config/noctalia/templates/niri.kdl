// Generated by Noctalia from the selected palette; the inactive border is Omarchy's.
layout {
    border {
        active-color "{{colors.primary.default.hex}}"
        inactive-color "#595959aa"
        urgent-color "{{colors.error.default.hex}}"
    }
    tab-indicator {
        active-color "{{colors.primary.default.hex}}"
        inactive-color "{{colors.primary_container.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }
    insert-hint { color "{{colors.primary.default.hex}}80"; }
}
recent-windows {
    highlight {
        active-color "{{colors.primary.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }
}
