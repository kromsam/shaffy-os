// Omarchy-inspired geometry with native Niri scrolling columns.
layout {
    gaps 10
    center-focused-column "never"
    background-color "transparent"
    default-column-width { proportion 0.49; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    focus-ring { off; }
    border {
        on
        width 2
        active-color "#e68e0d"
        inactive-color "#333333"
        urgent-color "#D35F5F"
    }
    shadow { off; }
    struts {}
}
