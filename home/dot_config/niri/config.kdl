// Derived from CachyOS cachyos-niri-noctalia 1.4.0 (github.com/CachyOS/cachyos-niri-noctalia),
// GPL-3.0-only; modified for Shaffy OS, 2026. See THIRD-PARTY.md.
include "./cfg/animation.kdl"
// Keep the baseline shell startup here; it needs no separate configuration file.
spawn-at-startup "noctalia"
include "./cfg/keybinds.kdl"
include "./cfg/input.kdl"
include "./cfg/display.kdl"
include "./cfg/layout.kdl"
include "./cfg/rules.kdl"
include "./cfg/misc.kdl"
// Generated colors are applied last; geometry remains in cfg/layout.kdl.
include "noctalia.kdl"
// Runtime toggles must follow generated colors, so borders can be disabled.
include "runtime-overrides.kdl"

// Super+S shows and hides this named workspace; Niri has no sticky floating
// windows to make a scratchpad from.
workspace "scratchpad"

// The profiles' fragments, in the supplement's list order (docs/PROFILES.md).
include "profiles.kdl"

// The supplement's optional fragment comes last, so its bindings override the
// public ones. Niri inserts outputs and other multipart sections instead of merging
// them, so each output keeps one owner (desktop.displays).
include "user.kdl"
