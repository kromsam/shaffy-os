[Unit]
Description=Shared local GBrain memory service
ConditionPathExists=%h/.config/gbrain-mcp/client.json

[Service]
Type=simple
ExecStart=%h/.local/bin/gbrain serve --http --bind 127.0.0.1 --port 3131 --surface starter --suppress-bootstrap-token
WorkingDirectory=%h
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
Environment=GBRAIN_SERVE_SYNC_IPC=0
UnsetEnvironment=OPENAI_API_KEY ANTHROPIC_API_KEY GEMINI_API_KEY GOOGLE_API_KEY

[Install]
WantedBy=default.target
