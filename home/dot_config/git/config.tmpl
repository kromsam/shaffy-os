{{- $s := (includeTemplate "shaffy.json" . | fromJson).shaffy.settings -}}
{{- $id := dig "identity" dict $s -}}
{{- $key := dig "signing" "key" "" $id -}}
{{- $signing := and $key (stat (includeTemplate "path" (dict "home" .chezmoi.homeDir "path" $key))) -}}
{{- if or (hasKey $id "name") (hasKey $id "email") $signing -}}
[user]
{{- if hasKey $id "name" }}
    name = {{ $id.name }}
{{- end }}
{{- if hasKey $id "email" }}
    email = {{ $id.email }}
{{- end }}
{{- if $signing }}
    signingkey = {{ $key }}
{{- end }}
{{ end -}}
[init]
    defaultBranch = main
# Omarchy's Git defaults: rebase local commits on pull, track the remote branch on
# the first push, clearer diffs and remembered conflict resolutions.
[pull]
    rebase = true
[push]
    autoSetupRemote = true
[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
[rerere]
    enabled = true
[branch]
    sort = -committerdate
[tag]
    sort = -version:refname
[column]
    ui = auto
[commit]
    verbose = true
{{- if $signing }}
    gpgsign = true
[gpg]
    format = ssh
{{- end }}
