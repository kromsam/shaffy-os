# One whitespace convention for editors and shfmt (STYLE.md).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
# shfmt: case branches indented, as the Google Shell Style Guide does.
switch_case_indent = true

[*.py]
indent_size = 4
