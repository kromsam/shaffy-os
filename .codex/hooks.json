{
  "description": "Record what differs from HEAD when a session starts, then format and lint what the agent changes and hand what remains back to it (lib/shaffy/lint.py).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/bin/shaffy lint --hook",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/bin/shaffy lint --hook",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/bin/shaffy lint --hook",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
